# Serveur
PORT=3001
# DATA_DIR=./server/data            # cache du GTFS téléchargé
# GTFS_URL=...                      # par défaut : GTFS Agglobus sur data.gouv.fr
# GTFS_REFRESH_HOURS=24

# Temps réel SIRI (Métropole AMP)
# SIRI_ENABLED=true
# SIRI_ENDPOINT=https://siri.lametropolemobilite.fr/AUB_TPE
# SIRI_REQUESTOR_REF=open-data
# SIRI_MAX_RPM=8                    # quota officiel : 10-20 req/min
# SIRI_STOP_REF_TEMPLATE=AUB:StopPoint:BP:{id}:LOC
# SIRI_BACKOFF_MS=600000

# Site officiel du réseau (info trafic, plans)
# OFFICIAL_SITE_URL=https://lignes-agglo.fr
# OFFICIAL_REFRESH_MS=600000

# Info trafic GTFS-RT
# ALERTS_URL=https://api-mobilite.rbgl.fr/api/v1/mamp/getServiceAlerts

# Front (au build) : fond de carte Google Maps (Map Tiles API).
# Clé navigateur restreinte aux domaines du site ; sans clé, la carte utilise OpenStreetMap.
# VITE_GOOGLE_MAPS_API_KEY=
# Fond de carte de repli
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; contributeurs OpenStreetMap
